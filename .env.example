APP_NAME="Temp File Storage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=file_storage
DB_USERNAME=file_storage
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Файлы
FILES_DISK=local
FILES_MAX_SIZE_KB=10240
FILES_TTL_HOURS=24

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_EMAIL_QUEUE=notifications.email
RABBITMQ_RETRY_ATTEMPTS=5
RABBITMQ_RETRY_DELAY_MS=30000

# Уведомления
NOTIFICATION_CHANNELS=email
NOTIFICATION_EMAIL=admin@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта (Mailpit из docker-compose; UI: http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@file-storage.local
MAIL_FROM_NAME="${APP_NAME}"
